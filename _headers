/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self' https://adlisho.online; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://seskia.online https://api.qrserver.com; connect-src 'self' https://adlisho.online https://api.telegram.org; font-src https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/manifest.json
  Cache-Control: public, max-age=3600

/config.json
  Cache-Control: no-store

/favicon.svg
  Cache-Control: public, max-age=604800, immutable

/qr-download.png
  Cache-Control: public, max-age=604800, immutable

/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/functions/*
  Cache-Control: no-store
