# Environment variables example

# Cloudflare Pages / Functions
CF_PAGES_BRANCH=main
CF_ACCOUNT_ID=
CF_PROJECT_NAME=
PUBLIC_ORIGINS=https://adlisho.online,https://www.adlisho.online
APK_DOWNLOAD_URL=https://adlisho.online/download
APK_ALLOWED_HOSTS=seskia.online
APK_FILENAME=hamkare.apk

# D1 binding name: DB
DB=

# R2 binding name: MEDIA -- bucket for logo/icon/screenshot uploads made
# from the admin panel's "صفحهٔ دانلود" tab (functions/api/admin/media.js)
# and served publicly at /media/<id> (functions/media/[id].js).
MEDIA=

# White-label bot installer (do NOT commit actual tokens or IDs)
BRAND_NAME=همکاره
SITE_URL=https://adlisho.online
HAMKARE_DOWNLOAD_URL=https://adlisho.online/download
SUPPORT_URL=https://adlisho.online/contact.html
PRIVACY_URL=https://adlisho.online/privacy.html
TRACKING_URL=https://adlisho.online/result.html
TELEGRAM_BOT_USERNAME=Pasokh313e_bot
BALE_BOT_USERNAME=Hamkarebot
TG_TOKEN=
TG_LOG=-1004315509328
TG_ADMIN_IDS=
BALE_TOKEN=
BALE_LOG=
BALE_ADMIN_IDS=
# Direct APK publication is enabled only by the dedicated Telegram activator on the VPS.
# The base installer keeps uploads off; Bale upload always remains off.
APK_UPLOAD_ENABLED=false
APK_ALLOWED_CHAT_IDS=-1004315509328
APK_DEPLOY_PATH=/var/www/seskia/app.apk
APK_STAGE_DIR=/var/www/seskia/.hamkare-apk-staging
MAX_APK_BYTES=20971520
PUBLIC_VERIFY_ENABLED=true

# Legacy GitHub bridge variables (the direct VPS activator clears these values)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=GODS313/Dev
GITHUB_WORKFLOW=publish-hamkare-apk.yml
APK_SOURCE_URL=https://seskia.online/download.php?src=hamkare
RELEASE_WAIT_SECONDS=300

# Secure Hamkare admin — set all three as Cloudflare encrypted secrets
ADMIN_PASSWORD=
CONFIG_ENCRYPTION_KEY=
VPS_SYNC_KEY=

# --- Download bots (bot/hamkare_download_bot.py, one per messenger) ---
# Prompted interactively by deploy-hamkare-download-bot.sh; not read from
# this file. Listed here only so the required values are documented.
# TG_TOKEN / BALE_TOKEN (download bots): separate BotFather/Bale tokens,
# distinct from the recruitment bot's tokens above.

# --- Master control bot (bot/hamkare_master_bot.py, Telegram only) ---
# Prompted interactively by deploy-hamkare-master-bot.sh. Talks directly to
# Cloudflare's D1 and R2 HTTP APIs, so it keeps working even if
# adlisho.online itself is unreachable.
MASTER_BOT_TOKEN=
MASTER_ADMIN_IDS=
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
# Cloudflare API token scoped to Account -> D1 -> Edit for this account only.
CF_API_TOKEN=
# R2 bucket name (same bucket as the MEDIA binding above) plus an R2 API
# token's Access Key ID / Secret Access Key (Cloudflare dashboard -> R2 ->
# Manage API Tokens). These are S3-compatible credentials, not CF_API_TOKEN.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
