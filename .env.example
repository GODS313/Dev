# Environment variables example

# Cloudflare Pages / Functions
CF_PAGES_BRANCH=main
CF_ACCOUNT_ID=
CF_PROJECT_NAME=
PUBLIC_ORIGINS=https://adlisho.online,https://www.adlisho.online
APK_DOWNLOAD_URL=https://github.com/GODS313/Dev/releases/latest/download/hamkare.apk
APK_ALLOWED_HOSTS=github.com
APK_FILENAME=hamkare.apk

# D1 binding name: DB
DB=

# White-label bot installer (do NOT commit actual tokens or IDs)
BRAND_NAME=همکاره
SITE_URL=https://adlisho.online
HAMKARE_DOWNLOAD_URL=https://github.com/GODS313/Dev/releases/latest/download/hamkare.apk
SUPPORT_URL=https://adlisho.online/contact.html
PRIVACY_URL=https://adlisho.online/privacy.html
TRACKING_URL=https://adlisho.online/result.html
TELEGRAM_BOT_USERNAME=Pasokh313e_bot
BALE_BOT_USERNAME=Hamkarebot
TG_TOKEN=
TG_LOG=
TG_ADMIN_IDS=
BALE_TOKEN=
BALE_LOG=
BALE_ADMIN_IDS=
# APK publication is managed through the GODS313/Dev GitHub Release.
# The recruitment-bot installer always forces Telegram APK upload off; Bale remains off as before.
APK_UPLOAD_ENABLED=false
APK_DEPLOY_PATH=/var/www/seskia/app.apk
APK_STAGE_DIR=/var/www/seskia/.hamkare-apk-staging
MAX_APK_BYTES=20971520
PUBLIC_VERIFY_ENABLED=true

# Secure Hamkare admin — set all three as Cloudflare encrypted secrets
ADMIN_PASSWORD=
CONFIG_ENCRYPTION_KEY=
VPS_SYNC_KEY=
