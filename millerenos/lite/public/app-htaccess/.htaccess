# Mini App: framed by Telegram web clients; assets are content-hashed.
Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors https://web.telegram.org https://webk.telegram.org https://webz.telegram.org"
Header set X-Robots-Tag "noindex, nofollow"
<FilesMatch "index\.html$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
