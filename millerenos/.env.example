# Millerenos server configuration. Copy to .env (never commit real values).
NODE_ENV=development            # development | staging | production
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080   # must be https in production (Mini App requirement)
TRUST_PROXY=false               # true when behind a reverse proxy / load balancer
LOG_LEVEL=info

# PostgreSQL — three roles (see ops/db/bootstrap-roles.sql)
DATABASE_URL=postgres://millerenos_app:CHANGE_ME@localhost:5432/millerenos
DATABASE_SYSTEM_URL=postgres://millerenos_system:CHANGE_ME@localhost:5432/millerenos
DATABASE_MIGRATION_URL=postgres://millerenos_owner:CHANGE_ME@localhost:5432/millerenos
DATABASE_POOL_MAX=10

# Telegram (from @BotFather). Leave empty to run without the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=        # 32+ chars [A-Za-z0-9_-]; generate: openssl rand -hex 32
PLATFORM_ADMIN_TELEGRAM_IDS=    # comma-separated numeric Telegram user ids → superadmin

# Keyed hashing secret (trial anti-abuse). generate: openssl rand -hex 32
DATA_HASH_SECRET=

# Trial
TRIAL_DURATION_MINUTES=60
TRIAL_AI_REQUESTS=20
TRIAL_MAX_PRODUCTS=25
TRIAL_MAX_ORDERS=50

# AI (optional)
AI_PROVIDER=disabled            # anthropic | disabled
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low

# Observability
METRICS_TOKEN=                  # bearer token for /metrics (16+ chars); empty disables it
SECURITY_CONTACT=               # e.g. mailto:security@your-domain for /.well-known/security.txt
